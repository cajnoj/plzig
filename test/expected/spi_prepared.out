-- freeing makes room again
CREATE FUNCTION pt_cap_free() RETURNS int LANGUAGE plzig AS $$
    var i: i32 = 0;
    while (i < 10) : (i += 1) {
        var p = try plzig.spi.prepare("SELECT 1", &.{});
        p.free();
    }
    return i;
$$;
SELECT pt_cap_free();
 pt_cap_free 
