FROM (SELECT (random() * 10 ^ (floor(random() * 600) - 300))::numeric(1000, 400) * (CASE WHEN random() < 0.5 THEN -1 ELSE 1 END) AS v
        FROM generate_series(1, 2000)) s
WHERE v <> 0 AND abs(v) BETWEEN 1e-307 AND 1e308;
