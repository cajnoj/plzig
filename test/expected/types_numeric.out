SELECT count(*) FILTER (WHERE split_part(nm_view(n), ' ', 1)::int IS DISTINCT FROM scale(n)) AS scale_mismatches
FROM nm_vals WHERE n IS NOT NULL AND n <> 'NaN' AND abs(n) <> 'Infinity';
