    repeat('a', 65) || '.wasm',
    repeat('a', 64) || '.wasm.bak',
    repeat('a', 64) || '.WASM',
    repeat('a', 64),
    repeat('g', 64) || '.wasm',
    'compile.lock', '.', '..', '']) AS name;
