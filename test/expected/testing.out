SELECT abi, sc, sandbox_missing(abi, sc)
  FROM (VALUES (-38, -22), (-1, 0), (0, 1), (1, 0), (3, 0), (5, -38), (6, 0), (8, 0), (9, 0), (10, 0), (10, -1), (12, 1)) v(abi, sc);
 abi | sc  |                                                                          sandbox_missing                                                                          
-----+-----+-------------------------------------------------------------------------------------------------------------------------------------------------------------------
 -38 | -22 | Landlock is not available (landlock_create_ruleset returned -38): no filesystem confinement; no seccomp filter (the kernel refused filter mode: Invalid argument)
  -1 |   0 | Landlock is not available (landlock_create_ruleset returned -1): no filesystem confinement
   0 |   1 | Landlock was not applied: no filesystem confinement; the seccomp filter was not installed
   1 |   0 | Landlock ABI 1 lacks restrictions on file truncation, TCP, device ioctl, signals and abstract UNIX sockets, pathname UNIX sockets and UDP
   3 |   0 | Landlock ABI 3 lacks restrictions on TCP, device ioctl, signals and abstract UNIX sockets, pathname UNIX sockets and UDP
   5 | -38 | Landlock ABI 5 lacks restrictions on signals and abstract UNIX sockets, pathname UNIX sockets and UDP; no seccomp filter (not supported on this architecture)
   6 |   0 | Landlock ABI 6 lacks restrictions on pathname UNIX sockets and UDP
   8 |   0 | Landlock ABI 8 lacks restrictions on pathname UNIX sockets and UDP
   9 |   0 | Landlock ABI 9 lacks restrictions on UDP
  10 |   0 | 
  10 |  -1 | no seccomp filter (the kernel refused filter mode: Operation not permitted)
  12 |   1 | the seccomp filter was not installed
(12 rows)

