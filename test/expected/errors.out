----------------------+-------------------------------------------------------------------------------------------------------------------------------------------------------
                      | 22023 | PL/Zig: invalid SQLSTATE "" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 2351                 | 22023 | PL/Zig: invalid SQLSTATE "2351" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 235140               | 22023 | PL/Zig: invalid SQLSTATE "235140" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 p0001                | 22023 | PL/Zig: invalid SQLSTATE "p0001" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 2351a                | 22023 | PL/Zig: invalid SQLSTATE "2351a" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 23 14                | 22023 | PL/Zig: invalid SQLSTATE "23 14" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 23-14                | 22023 | PL/Zig: invalid SQLSTATE "23-14" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 235é                 | 22023 | PL/Zig: invalid SQLSTATE "235??" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 é2351                | 22023 | PL/Zig: invalid SQLSTATE "??2351" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 P0001                | 22023 | PL/Zig: invalid SQLSTATE "P0001 " | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
  P0001               | 22023 | PL/Zig: invalid SQLSTATE " P0001" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
 23514235142351423514 | 22023 | PL/Zig: invalid SQLSTATE "2351423514235142..." | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
(12 rows)

-- NUL and control bytes in the code (shown as ?)
SELECT err_show($$SELECT err_raise_b('\x3233003134'::bytea, 'm'::bytea, NULL, NULL)$$);
                                                                err_show                                                                 
-----------------------------------------------------------------------------------------------------------------------------------------
 22023 | PL/Zig: invalid SQLSTATE "23?14" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
(1 row)

SELECT err_show($$SELECT err_raise_b('\x0a1b5b3331'::bytea, 'm'::bytea, NULL, NULL)$$);
                                                                err_show                                                                 
-----------------------------------------------------------------------------------------------------------------------------------------
 22023 | PL/Zig: invalid SQLSTATE "??[31" | A SQLSTATE consists of exactly five characters, each a digit or an upper-case letter A-Z. | 
(1 row)

-- the code is checked before anything else
SELECT err_show($$SELECT err_raise_b('XX000'::bytea, '\xff'::bytea, NULL, NULL)$$);
                                                                       err_show                                                                       
------------------------------------------------------------------------------------------------------------------------------------------------------
 22023 | PL/Zig: SQLSTATE XX000 cannot be raised by a PL/Zig function | Class XX (internal error) is reserved for conditions of the server itself. | 
(1 row)

-- message, detail and hint: valid in the database encoding, no NUL
SELECT err_show($$SELECT err_raise_b('23514'::bytea, '\x61ff62'::bytea, NULL, NULL)$$);
                           err_show                            
---------------------------------------------------------------
 22021 | invalid byte sequence for encoding "UTF8": 0xff |  | 
(1 row)

SELECT err_show($$SELECT err_raise_b('23514'::bytea, 'm'::bytea, '\x6100'::bytea, NULL)$$);
                           err_show                            
---------------------------------------------------------------
 22021 | invalid byte sequence for encoding "UTF8": 0x00 |  | 
(1 row)

SELECT err_show($$SELECT err_raise_b('23514'::bytea, 'm'::bytea, NULL, '\xc3'::bytea)$$);
                           err_show                            
---------------------------------------------------------------
