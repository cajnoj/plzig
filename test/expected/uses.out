-- a function cannot use itself, nor be part of a cycle
CREATE FUNCTION uz.selfish(x int) RETURNS int STRICT LANGUAGE plzig AS $f$
    if (x <= 0) return 0;
    return 1 + (try call(x - 1)).?;  // direct recursion needs no directive
$f$;
