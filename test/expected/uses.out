RESET ROLE;
SET ROLE regress_plzig_dev;
-- DO blocks cannot use functions
DO $f$
//#use uz.twice(integer) as twice
    _ = try twice.call(1);
$f$ LANGUAGE plzig;
ERROR:  //#use is not supported in DO blocks
-- the used function's code is validated like a standalone function's
