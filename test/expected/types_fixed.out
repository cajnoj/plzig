-- SPI: every fixed-width column as a typed result (Result.row and cursor
-- rows), passed straight back as a prepared-statement parameter, compared
-- with the stored value in SQL
CREATE FUNCTION fx_spi_roundtrip(use_cursor bool) RETURNS text STRICT LANGUAGE plzig AS $$
    const q = "SELECT id, d, t, tz, ts, tstz, iv, u, o FROM fx_vals ORDER BY id";
    var check = try plzig.spi.prepare(
        "SELECT d IS NOT DISTINCT FROM $2 AND t IS NOT DISTINCT FROM $3 AND " ++
        "tz::text IS NOT DISTINCT FROM $4::text AND ts IS NOT DISTINCT FROM $5 AND " ++
        "tstz IS NOT DISTINCT FROM $6 AND iv::text IS NOT DISTINCT FROM $7::text AND " ++
        "u IS NOT DISTINCT FROM $8 AND o IS NOT DISTINCT FROM $9 FROM fx_vals WHERE id = $1",
        &.{ .int4, .date, .time, .timetz, .timestamp, .timestamptz, .interval, .uuid, .oid });
    defer check.free();
    const Row = struct {
        id: i32, d: ?plzig.Date, t: ?plzig.Time, tz: ?plzig.TimeTz, ts: ?plzig.Timestamp,
        tstz: ?plzig.TimestampTz, iv: ?plzig.Interval, u: ?plzig.Uuid, o: ?plzig.Oid,
        fn of(r: plzig.Row) !@This() {
            return .{ .id = try r.get(i32, 0), .d = try r.get(?plzig.Date, 1), .t = try r.get(?plzig.Time, 2),
                .tz = try r.get(?plzig.TimeTz, 3), .ts = try r.get(?plzig.Timestamp, 4),
                .tstz = try r.get(?plzig.TimestampTz, 5), .iv = try r.get(?plzig.Interval, 6),
                .u = try r.get(?plzig.Uuid, 7), .o = try r.get(?plzig.Oid, 8) };
        }
    };
    var rows: [16]Row = undefined;
    var n: usize = 0;
    if (use_cursor) {
        var p = try plzig.spi.prepare(q, &.{});
        var c = try p.open(.{});
        while (try c.next()) |r| : (n += 1) rows[n] = try Row.of(r);
    } else {
        const res = try plzig.spi.execute(q, &.{});
        while (n < res.rows) : (n += 1) rows[n] = try Row.of(try res.row(n));
    }
    var same: usize = 0;
    for (rows[0..n]) |x| {
        const r = try check.execute(.{ x.id, x.d, x.t, x.tz, x.ts, x.tstz, x.iv, x.u, x.o });
        if (try (try r.row(0)).get(bool, 0)) same += 1;
    }
    return try std.fmt.allocPrint(plzig.allocator, "{d} rows, {d} identical", .{ n, same });
$$;
SELECT fx_spi_roundtrip(false), fx_spi_roundtrip(true);
  fx_spi_roundtrip   |  fx_spi_roundtrip   
---------------------+---------------------
 9 rows, 9 identical | 9 rows, 9 identical
(1 row)

-- the kinds of the result columns, and the types the parameters get
CREATE FUNCTION fx_kinds() RETURNS text LANGUAGE plzig AS $$
    const a = plzig.allocator;
    var out: std.ArrayList(u8) = .empty;
    const r = try plzig.spi.execute("SELECT d, t, tz, ts, tstz, iv, u, o, o::regclass AS rc, d::text AS dt FROM fx_vals WHERE id = 1", &.{});
    const row = try r.row(0);
    for (0..row.len()) |i| try out.print(a, "{s} ", .{@tagName(try row.kind(i))});
    var p = try plzig.spi.prepare(
        "SELECT pg_typeof($1)::text || ' ' || pg_typeof($2) || ' ' || pg_typeof($3) || ' ' || pg_typeof($4) || ' ' || " ++
        "pg_typeof($5) || ' ' || pg_typeof($6) || ' ' || pg_typeof($7) || ' ' || pg_typeof($8)",
        &.{ .date, .time, .timetz, .timestamp, .timestamptz, .interval, .uuid, .oid });
    const r2 = try p.execute(.{ null, null, null, null, null, null, null, null });
    try out.print(a, "| {s}", .{try (try r2.row(0)).get([]const u8, 0)});
    return out.items;
$$;
SELECT fx_kinds();
                                                                                           fx_kinds                                                                                           
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 date time timetz timestamp timestamptz interval uuid oid other text | date time without time zone time with time zone timestamp without time zone timestamp with time zone interval uuid oid
(1 row)

-- SPI parameters are range-checked like results
CREATE FUNCTION fx_bad_param(which int) RETURNS text STRICT LANGUAGE plzig AS $$
    var p = try plzig.spi.prepare("SELECT $1::text, $2::text, $3::text, $4::text, $5::text",
        &.{ .date, .time, .timetz, .timestamp, .timestamptz });
    const r = try p.execute(.{
        plzig.Date{ .days = if (which == 1) 2145031949 else 0 },
        plzig.Time{ .usecs = if (which == 2) -1 else 0 },
        plzig.TimeTz{ .usecs = 0, .zone = if (which == 3) 57600 else 0 },
        plzig.Timestamp{ .usecs = if (which == 4) 9223371331200000000 else 0 },
        plzig.TimestampTz{ .usecs = if (which == 5) -211813488000000001 else 0 },
    });
    return try (try r.row(0)).get([]const u8, 0);
$$;
SELECT w, fx_err(format('SELECT fx_bad_param(%s)', w)) FROM generate_series(0, 5) w;
 w |                   fx_err                   
---+--------------------------------------------
 0 | ok
 1 | 22008: date out of range
 2 | 22008: time out of range
 3 | 22009: time zone displacement out of range
 4 | 22008: timestamp out of range
 5 | 22008: timestamp out of range
(6 rows)

-- a mismatching parameter kind is an error, never a conversion
CREATE FUNCTION fx_kind_mismatch() RETURNS text LANGUAGE plzig AS $$
    var p = try plzig.spi.prepare("SELECT $1", &.{.timestamptz});
    _ = try p.execute(.{plzig.Timestamp{ .usecs = 0 }});
    return "converted";
$$;
SELECT fx_err('SELECT fx_kind_mismatch()');
                                                               fx_err                                                                
-------------------------------------------------------------------------------------------------------------------------------------
 42804: PL/Zig: parameter $1 of the prepared statement is of type timestamp with time zone, but a value of kind timestamp was passed
(1 row)

CREATE FUNCTION fx_get_mismatch() RETURNS text LANGUAGE plzig AS $$
    const r = try plzig.spi.execute("SELECT now()", &.{});
    _ = try (try r.row(0)).get(plzig.Timestamp, 0);
    return "converted";
$$;
SELECT fx_err('SELECT fx_get_mismatch()');
                   fx_err                   
--------------------------------------------
 38000: plzig function failed: TypeMismatch
(1 row)

-- many rows: the sum of the raw values equals SQL's
CREATE FUNCTION fx_sum() RETURNS int8 LANGUAGE plzig AS $$
    var p = try plzig.spi.prepare("SELECT d, ts FROM generate_series(1, 20000) g, " ++
        "LATERAL (SELECT date '1900-01-01' + g * 3 AS d, timestamp '1900-01-01' + g * interval '3 days 1 second' AS ts) x", &.{});
    var c = try p.open(.{});
    var sum: i64 = 0;
    while (try c.next()) |r| sum += (try r.get(plzig.Date, 0)).days + @divTrunc((try r.get(plzig.Timestamp, 1)).usecs, 1000000);
    return sum;
$$;
SELECT fx_sum() = (SELECT sum((date '1900-01-01' + g * 3) - date '2000-01-01' +
                              (extract(epoch FROM timestamp '1900-01-01' + g * interval '3 days 1 second') - 946684800)::int8)
                   FROM generate_series(1, 20000) g) AS sum_matches;
 sum_matches 
