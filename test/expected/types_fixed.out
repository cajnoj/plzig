  2 | -2451545 0 0/57540 -211813488000000000 -211813488000000000 -2147483648/-2147483648/-2147482800000000 00000000-0000-0000-0000-000000000000 0                              | t
  3 | 2145031948 86400000000 86400000000/-57540 9223371331199999999 9223371331199999999 2147483647/2147483647/2147482800000000 ffffffff-ffff-ffff-ffff-ffffffffffff 4294967295 | t
  4 | 2147483647 1 43200000000/1 9223372036854775807 9223372036854775807 -2147483648/0/0 a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11 1                                                | t
  5 | -2147483648 86399999999 86399999999/0 -9223372036854775808 -9223372036854775808 0/-1/1 a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11 4294967294                                   | t
  6 | -730119 500000 500000/-50400 -63082281600000001 -63082281600000000 -1/0/0 12345678-1234-5678-1234-567812345678 2147483648                                                | t
  7 | -730120 43200000000 43200000000/50400 -1 -1 0/0/1 ffffffff-0000-0000-0000-000000000000 2147483647                                                                        | t
