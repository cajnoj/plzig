-- values built by the function, checked against SQL
CREATE FUNCTION fx_mk(days int, usecs int8, zone int, months int) RETURNS text STRICT LANGUAGE plzig AS $$
    const r = try plzig.spi.prepare(
        "SELECT $1 = date '2000-01-01' + $5, extract(epoch FROM $2) * 1000000 = $6, " ++
        "$3 = timestamp '2000-01-01' + $6 * interval '1 microsecond', " ++
        "$4 = timestamptz '2000-01-01 00:00+00' + $6 * interval '1 microsecond', " ++
        "extract(epoch FROM $7::time) * 1000000 = $6 AND -extract(timezone FROM $7) = $8, " ++
        "$9::text = (make_interval(months => $10, days => $5) + $6 * interval '1 microsecond')::text",
        &.{ .date, .time, .timestamp, .timestamptz, .int4, .int8, .timetz, .int4, .interval, .int4 });
    const res = try r.execute(.{
        plzig.Date{ .days = days }, plzig.Time{ .usecs = usecs }, plzig.Timestamp{ .usecs = usecs },
        plzig.TimestampTz{ .usecs = usecs }, days, usecs, plzig.TimeTz{ .usecs = usecs, .zone = zone }, zone,
        plzig.Interval{ .usecs = usecs, .days = days, .months = months }, months,
    });
    const row = try res.row(0);
    var out: [6]u8 = undefined;
    for (0..6) |i| out[i] = if (try row.get(bool, i)) 't' else 'f';
    return try plzig.allocator.dupe(u8, &out);
$$;
SELECT fx_mk(0, 0, 0, 0), fx_mk(-1, 86400000000, 57599, -1), fx_mk(8766, 43200000001, -57599, 2147483647),
       fx_mk(-2451545, 1, 3600, -2147483648);
 fx_mk  | fx_mk  | fx_mk  | fx_mk  
--------+--------+--------+--------
 tttttt | tttttt | tttttt | tttttt
(1 row)

-- range checks on results: PostgreSQL's limits and messages, no typmod
CREATE FUNCTION fx_ret_d(n int) RETURNS date STRICT LANGUAGE plzig AS $$ return plzig.Date{ .days = n }; $$;
CREATE FUNCTION fx_ret_t(n int8) RETURNS time STRICT LANGUAGE plzig AS $$ return plzig.Time{ .usecs = n }; $$;
CREATE FUNCTION fx_ret_tz(n int8, z int) RETURNS timetz STRICT LANGUAGE plzig AS $$
    return plzig.TimeTz{ .usecs = n, .zone = z };
$$;
CREATE FUNCTION fx_ret_ts(n int8) RETURNS timestamp STRICT LANGUAGE plzig AS $$ return plzig.Timestamp{ .usecs = n }; $$;
CREATE FUNCTION fx_ret_tstz(n int8) RETURNS timestamptz STRICT LANGUAGE plzig AS $$ return plzig.TimestampTz{ .usecs = n }; $$;
SELECT q, fx_err(q) FROM unnest(ARRAY[
  -- dates: [-2451545, 2145031948] and the two infinities
  'SELECT fx_ret_d(-2451545)', 'SELECT fx_ret_d(-2451546)', 'SELECT fx_ret_d(2145031948)',
  'SELECT fx_ret_d(2145031949)', 'SELECT fx_ret_d(2147483646)', 'SELECT fx_ret_d(-2147483647)',
  'SELECT fx_ret_d(2147483647)', 'SELECT fx_ret_d(-2147483648)',
  -- times: [0, 24:00:00]
  'SELECT fx_ret_t(0)', 'SELECT fx_ret_t(-1)', 'SELECT fx_ret_t(86400000000)', 'SELECT fx_ret_t(86400000001)',
  'SELECT fx_ret_t(-9223372036854775808)',
  'SELECT fx_ret_tz(86400000001, 0)', 'SELECT fx_ret_tz(0, 57599)', 'SELECT fx_ret_tz(0, 57600)',
  'SELECT fx_ret_tz(0, -57599)', 'SELECT fx_ret_tz(0, -57600)', 'SELECT fx_ret_tz(-1, 0)',
  -- timestamps: [MIN_TIMESTAMP, END_TIMESTAMP) and the two infinities
  'SELECT fx_ret_ts(-211813488000000000)', 'SELECT fx_ret_ts(-211813488000000001)',
  'SELECT fx_ret_ts(9223371331199999999)', 'SELECT fx_ret_ts(9223371331200000000)',
  'SELECT fx_ret_ts(9223372036854775806)', 'SELECT fx_ret_ts(-9223372036854775807)',
  'SELECT fx_ret_ts(9223372036854775807)', 'SELECT fx_ret_ts(-9223372036854775808)',
  'SELECT fx_ret_tstz(-211813488000000001)', 'SELECT fx_ret_tstz(9223371331200000000)',
  'SELECT fx_ret_tstz(-211813488000000000)', 'SELECT fx_ret_tstz(9223372036854775807)'
]) AS q;
