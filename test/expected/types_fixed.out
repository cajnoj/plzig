-- interval extremes no version's interval_in parses: built by the function,
-- checked field by field, and passed through SQL and back
CREATE FUNCTION fx_ret_iv(m int, d int, us int8) RETURNS interval STRICT LANGUAGE plzig AS $$
    return plzig.Interval{ .months = m, .days = d, .usecs = us };
$$;
SELECT m, d, us, fx_raw(NULL, NULL, NULL, NULL, NULL, fx_iv(fx_ret_iv(m, d, us)), NULL, NULL) AS raw
FROM (VALUES (2147483647, 2147483646, 9223372036854775807), (-2147483647, -2147483648, -9223372036854775807),
             (2147483646, 2147483647, 9223372036854775807), (-2147483648, 0, 1)) v(m, d, us);
      m      |      d      |          us          |                            raw                             
-------------+-------------+----------------------+------------------------------------------------------------
  2147483647 |  2147483646 |  9223372036854775807 | - - - - - 2147483647/2147483646/9223372036854775807 - -
 -2147483647 | -2147483648 | -9223372036854775807 | - - - - - -2147483647/-2147483648/-9223372036854775807 - -
  2147483646 |  2147483647 |  9223372036854775807 | - - - - - 2147483646/2147483647/9223372036854775807 - -
 -2147483648 |           0 |                    1 | - - - - - -2147483648/0/1 - -
(4 rows)

