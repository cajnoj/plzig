--
-- types_fixed: the natively mapped fixed-width types date, time, timetz,
-- timestamp, timestamptz, interval, uuid and oid (doc/abi.md, "Kinds"):
-- arguments, results, NULL, boundary values, the range checks of values a
-- function returns or passes as SPI parameter, SPI parameters and result
-- columns (execute, prepared statements, cursors).  Everything is compared
-- with the same computation in SQL.
--
\set VERBOSITY terse
SET datestyle = 'ISO, YMD';
SET IntervalStyle = 'postgres';
SET TimeZone = 'UTC';
-- the SQLSTATE and message of a statement, or 'ok'
CREATE FUNCTION fx_err(q text) RETURNS text LANGUAGE plpgsql AS $$
BEGIN
    EXECUTE q;
    RETURN 'ok';
EXCEPTION WHEN OTHERS THEN
    RETURN SQLSTATE || ': ' || SQLERRM;
END $$;
CREATE TABLE fx_vals (id int PRIMARY KEY, d date, t time, tz timetz, ts timestamp,
                      tstz timestamptz, iv interval, u uuid, o oid);
INSERT INTO fx_vals VALUES
  (1, '2024-02-29', '13:45:56.789012', '13:45:56.789012+05:30', '2024-02-29 13:45:56.789012',
      '2024-02-29 13:45:56.789012+00', '1 year 2 mons 3 days 04:05:06.000007',
      'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', 12345),
  -- the smallest finite values
  (2, '4714-11-24 BC', '00:00', '00:00:00-15:59', '4714-11-24 00:00:00 BC',
      '4714-11-24 00:00:00+00 BC', '-178956970 years -8 months -2147483648 days -596523 hours',
      '00000000-0000-0000-0000-000000000000', 0),
  -- the largest finite values
  (3, '5874897-12-31', '24:00:00', '24:00:00+15:59', '294276-12-31 23:59:59.999999',
      '294276-12-31 23:59:59.999999+00', '178956970 years 7 months 2147483647 days 596523 hours',
      'ffffffff-ffff-ffff-ffff-ffffffffffff', 4294967295),
  (4, 'infinity', '00:00:00.000001', '12:00-00:00:01', 'infinity', 'infinity',
      '-178956970 years -8 months', 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11', 1),
  (5, '-infinity', '23:59:59.999999', '23:59:59.999999+00', '-infinity', '-infinity',
      '-1 days +00:00:00.000001', '{a0eebc99-9c0b4ef8-bb6d6bb9-bd380a11}', 4294967294),
  -- year boundaries, BC dates, year 1 and 1 BC
  (6, '0001-01-01', '00:00:00.5', '00:00:00.5+14', '0001-12-31 23:59:59.999999 BC',
      '0001-01-01 00:00:00+00', '-1 mons', '12345678-1234-5678-1234-567812345678', 2147483648),
  (7, '0001-12-31 BC', '12:00', '12:00-14', '1999-12-31 23:59:59.999999',
      '1999-12-31 23:59:59.999999+00', '00:00:00.000001', 'ffffffff-0000-0000-0000-000000000000', 2147483647),
  -- leap second input: PostgreSQL normalises 23:59:60 to the next minute
  (8, '2000-01-01', '23:59:60', '23:59:60+01', '2016-12-31 23:59:60', '2016-12-31 23:59:60+00',
      '0', '00000000-0000-0000-0000-000000000001', 16384),
  (9, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
-- identity functions (non-strict: NULL arrives as null)
CREATE FUNCTION fx_d(x date) RETURNS date LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_t(x time) RETURNS time LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_tz(x timetz) RETURNS timetz LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_ts(x timestamp) RETURNS timestamp LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_tstz(x timestamptz) RETURNS timestamptz LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_iv(x interval) RETURNS interval LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_u(x uuid) RETURNS uuid LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_o(x oid) RETURNS oid LANGUAGE plzig AS $$ return x; $$;
SELECT id,
       fx_d(d) IS NOT DISTINCT FROM d AS d, fx_t(t) IS NOT DISTINCT FROM t AS t,
       fx_tz(tz)::text IS NOT DISTINCT FROM tz::text AS tz, fx_ts(ts) IS NOT DISTINCT FROM ts AS ts,
       fx_tstz(tstz) IS NOT DISTINCT FROM tstz AS tstz,
       fx_iv(iv)::text IS NOT DISTINCT FROM iv::text AS iv,
       fx_u(u) IS NOT DISTINCT FROM u AS u, fx_o(o) IS NOT DISTINCT FROM o AS o
FROM fx_vals ORDER BY id;
