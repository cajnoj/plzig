-- the typmod of a result is not kept by PostgreSQL (pg_proc has none): as
-- for every other language, also PL/pgSQL
CREATE FUNCTION fx_ts0(x timestamp) RETURNS timestamp(0) STRICT LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_ts0_plpgsql(x timestamp) RETURNS timestamp(0) STRICT LANGUAGE plpgsql AS $$ BEGIN RETURN x; END $$;
CREATE FUNCTION fx_ivd(x interval) RETURNS interval day STRICT LANGUAGE plzig AS $$ return x; $$;
CREATE FUNCTION fx_ivd_plpgsql(x interval) RETURNS interval day STRICT LANGUAGE plpgsql AS $$ BEGIN RETURN x; END $$;
SELECT fx_ts0('2024-01-01 12:34:56.789'), fx_ts0_plpgsql('2024-01-01 12:34:56.789'),
       fx_ivd('1 day 02:03:04.5'), fx_ivd_plpgsql('1 day 02:03:04.5');
         fx_ts0          |     fx_ts0_plpgsql      |      fx_ivd      |  fx_ivd_plpgsql  
-------------------------+-------------------------+------------------+------------------
 2024-01-01 12:34:56.789 | 2024-01-01 12:34:56.789 | 1 day 02:03:04.5 | 1 day 02:03:04.5
(1 row)

-- a domain is passed as text, and its typmod and constraints are enforced
-- by its input function, as for every domain
CREATE DOMAIN fx_ts0_dom AS timestamp(0) CHECK (VALUE > '2000-01-01');
CREATE FUNCTION fx_dom(x fx_ts0_dom) RETURNS fx_ts0_dom STRICT LANGUAGE plzig AS $$
    return try std.fmt.allocPrint(plzig.allocator, "{s}.6", .{x});
$$;
SELECT fx_dom('2024-01-01 12:34:56'), fx_err('SELECT fx_dom(''2000-01-01'')');
       fx_dom        |                                     fx_err                                      
---------------------+---------------------------------------------------------------------------------
 2024-01-01 12:34:57 | 23514: value for domain fx_ts0_dom violates check constraint "fx_ts0_dom_check"
(1 row)

CREATE FUNCTION fx_dom_null() RETURNS fx_ts0_dom LANGUAGE plzig AS $$ return "1999-01-01"; $$;
SELECT fx_err('SELECT fx_dom_null()');
                                     fx_err                                      
---------------------------------------------------------------------------------
 23514: value for domain fx_ts0_dom violates check constraint "fx_ts0_dom_check"
