-- what the function sees: PostgreSQL's representation, raw
CREATE FUNCTION fx_raw(d date, t time, tz timetz, ts timestamp, tstz timestamptz,
                       iv interval, u uuid, o oid) RETURNS text LANGUAGE plzig AS $$
    const a = plzig.allocator;
    var out: std.ArrayList(u8) = .empty;
    if (d) |x| try out.print(a, "{d}", .{x.days}) else try out.appendSlice(a, "-");
    if (t) |x| try out.print(a, " {d}", .{x.usecs}) else try out.appendSlice(a, " -");
    if (tz) |x| try out.print(a, " {d}/{d}", .{ x.usecs, x.zone }) else try out.appendSlice(a, " -");
    if (ts) |x| try out.print(a, " {d}", .{x.usecs}) else try out.appendSlice(a, " -");
    if (tstz) |x| try out.print(a, " {d}", .{x.usecs}) else try out.appendSlice(a, " -");
    if (iv) |x| try out.print(a, " {d}/{d}/{d}", .{ x.months, x.days, x.usecs }) else try out.appendSlice(a, " -");
    var buf: [36]u8 = undefined;
    if (u) |x| try out.print(a, " {s}", .{x.format(&buf)}) else try out.appendSlice(a, " -");
    if (o) |x| try out.print(a, " {d}", .{x.value}) else try out.appendSlice(a, " -");
    return out.items;
$$;
-- the same, computed in SQL (finite values only: infinities are their own encoding)
CREATE FUNCTION fx_raw_sql(r fx_vals) RETURNS text LANGUAGE sql AS $$
    SELECT concat_ws(' ',
        CASE WHEN r.d IS NULL THEN '-' WHEN r.d = 'infinity' THEN '2147483647'
             WHEN r.d = '-infinity' THEN '-2147483648' ELSE (r.d - date '2000-01-01')::text END,
        coalesce((extract(epoch FROM r.t) * 1000000)::int8::text, '-'),
        coalesce((extract(epoch FROM r.tz::time) * 1000000)::int8 || '/' || (-extract(timezone FROM r.tz))::int, '-'),
        CASE WHEN r.ts IS NULL THEN '-' WHEN r.ts = 'infinity' THEN '9223372036854775807'
             WHEN r.ts = '-infinity' THEN '-9223372036854775808'
             ELSE (extract(epoch FROM r.ts - timestamp '2000-01-01') * 1000000)::int8::text END,
        CASE WHEN r.tstz IS NULL THEN '-' WHEN r.tstz = 'infinity' THEN '9223372036854775807'
             WHEN r.tstz = '-infinity' THEN '-9223372036854775808'
             ELSE (extract(epoch FROM r.tstz - timestamptz '2000-01-01 00:00+00') * 1000000)::int8::text END,
        coalesce((extract(year FROM r.iv) * 12 + extract(month FROM r.iv))::int || '/' ||
                 extract(day FROM r.iv)::int || '/' ||
                 (extract(hour FROM r.iv) * 3600000000 + extract(minute FROM r.iv) * 60000000 +
                  extract(microseconds FROM r.iv))::int8, '-'),
        coalesce(r.u::text, '-'),
        coalesce(r.o::text, '-'))
$$;
SELECT id, fx_raw(d, t, tz, ts, tstz, iv, u, o) AS raw,
       fx_raw(d, t, tz, ts, tstz, iv, u, o) = fx_raw_sql(fx_vals) AS same_as_sql
FROM fx_vals ORDER BY id;
 id |                                                                                   raw                                                                                    | same_as_sql 
