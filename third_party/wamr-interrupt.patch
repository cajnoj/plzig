PL/Zig patch for WebAssembly Micro Runtime (WAMR) 2.4.5,
commit 25bd7eb63e828e4bd242cc9b38d260b4b31c6605.

Makes the classic interpreter poll two host-provided interrupt flags at
every branch, call and function entry when built without the thread
manager and with -DWASM_ENABLE_PLZIG_INTERRUPT=1, so that PostgreSQL query
cancel and backend termination stop running guest code.

This patch is a derivative of WAMR and is licensed, like the file it
modifies, under the Apache License 2.0 with LLVM Exceptions
(SPDX: Apache-2.0 WITH LLVM-exception); see LICENSES/ in this repository.
Modifications Copyright (c) 2026 Jonathan Jacobson.

Applied by third_party/prepare-wamr.sh with: patch -p1 --fuzz=0

--- a/core/iwasm/interpreter/wasm_interp_classic.c
+++ b/core/iwasm/interpreter/wasm_interp_classic.c
@@ -3,6 +3,14 @@
  * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
  */
 
+/*
+ * NOTICE: this file was modified by the PL/Zig project
+ * (Copyright (c) 2026 Jonathan Jacobson): CHECK_SUSPEND_FLAGS() is also
+ * defined when the thread manager is disabled and
+ * WASM_ENABLE_PLZIG_INTERRUPT is set, polling host-provided interrupt flags.
+ * The modifications are licensed under the same terms as this file.
+ */
+
 #include "wasm_interp.h"
 #include "bh_log.h"
 #include "wasm_runtime.h"
@@ -1452,6 +1460,20 @@
     } while (0)
 #endif /* WASM_ENABLE_DEBUG_INTERP */
 #endif /* WASM_ENABLE_THREAD_MGR */
+#if WASM_ENABLE_THREAD_MGR == 0 && WASM_ENABLE_PLZIG_INTERRUPT != 0
+/* PL/Zig: poll host interrupt flags (PostgreSQL QueryCancelPending and
+   ProcDiePending) at every branch, call and function entry; trap if set. */
+#include <signal.h>
+extern volatile sig_atomic_t *wamr_plzig_interrupt_flags[2];
+#define CHECK_SUSPEND_FLAGS()                                       \
+    do {                                                            \
+        if (*wamr_plzig_interrupt_flags[0]                          \
+            || *wamr_plzig_interrupt_flags[1]) {                    \
+            wasm_set_exception(module, "plzig: interrupted");       \
+            goto got_exception;                                     \
+        }                                                           \
+    } while (0)
+#endif /* WASM_ENABLE_PLZIG_INTERRUPT */
 
 #if WASM_ENABLE_THREAD_MGR != 0 && WASM_ENABLE_DEBUG_INTERP != 0
 #if BH_ATOMIC_32_IS_ATOMIC != 0
