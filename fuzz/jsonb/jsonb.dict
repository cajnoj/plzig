# fuzz/jsonb: tokens of the jsonb on-disk layout and the numeric formats
# (little-endian u32 container headers and JEntries, numeric headers)
hdr_object="\x01\x00\x00\x20"
hdr_array="\x01\x00\x00\x40"
hdr_scalar="\x01\x00\x00\x50"
je_string="\x01\x00\x00\x00"
je_numeric="\x08\x00\x00\x10"
je_false="\x00\x00\x00\x20"
je_true="\x00\x00\x00\x30"
je_null="\x00\x00\x00\x40"
je_container="\x08\x00\x00\x50"
je_has_off="\x01\x00\x00\x80"
varlena4="\x18\x00\x00\x00"
varlena1="\x0b"
num_short="\x00\x80"
num_short_neg="\x00\xa0"
num_nan="\x00\xc0"
num_pinf="\x00\xd0"
num_ninf="\x00\xf0"
num_long="\x00\x40\xff\xff"
wire_nan="\x00\x00\x00\x00\xc0\x00\x00\x00"
wire_one="\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01"
digit_9999="\x27\x0f"
digit_bad="\x27\x10"
